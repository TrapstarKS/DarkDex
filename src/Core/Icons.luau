--[[
	Icons embedded in IconAtlas (generated by scripts/icons.py from Roblox Studio).

	Class icons are looked up by class name. The client only ships the legacy
	ClassImages.PNG strip (indexed by the RMD ExplorerImageIndex), which lacks most modern
	classes, so the Studio icons are written to the workspace and loaded through
	getcustomasset; without it the legacy strip is the fallback. Classes without their own
	icon use the nearest superclass icon.
]]

local Context = require("@core/Context")
local IconAtlas = require("@core/IconAtlas")

local env = Context.env

-- Studio icons shared by classes that have no icon file of their own. Applied along the
-- superclass chain, so ValueBase covers NumberValue, StringValue, ObjectValue and the rest.
local ICON_ALIASES = {
	ValueBase = "Value",
	DataModel = "Place",
	BasePlayerGui = "StarterGui",
	PlayerScripts = "StarterPlayerScripts",
	StarterGear = "StarterPack",
	Accoutrement = "Accessory",
	JointInstance = "Weld",
	Light = "PointLight",
	Clothing = "Shirt",
	FileMesh = "SpecialMesh",
	CylinderMesh = "SpecialMesh",
	BaseScript = "Script",
	AnimationTrack = "Animation",
	KeyframeSequence = "Animation",
	Keyframe = "Animation",
	PoseBase = "Animation",
	PartOperation = "UnionOperation",
	TerrainRegion = "Terrain",
	GuiBase3d = "SelectionBox",
	ParticleEmitter2D = "ParticleEmitter",
}

local LEGACY_CLASS_ASSET = "rbxasset://textures/ClassImages.PNG"
local BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function decodeBase64(data: string): string
	local values = {}
	for index = 1, #BASE64 do
		values[string.byte(BASE64, index)] = index - 1
	end

	data = string.gsub(data, "=", "")
	local output = buffer.create(#data * 3 // 4)
	local offset, bits, bitCount = 0, 0, 0
	for index = 1, #data do
		bits = bit32.bor(bit32.lshift(bits, 6), values[string.byte(data, index)])
		bitCount += 6
		if bitCount >= 8 then
			bitCount -= 8
			buffer.writeu8(output, offset, bit32.band(bit32.rshift(bits, bitCount), 0xFF))
			offset += 1
		end
	end
	return buffer.tostring(output)
end

-- Writes the PNG to dex/assets (only when it changed) and returns its custom asset id
local function loadPng(name: string, base64: string): string?
	if not (env.getcustomasset and env.writefile) then return nil end

	local path = `dex/assets/{name}.png`
	local png = decodeBase64(base64)
	local readSuccess, isCurrent = pcall(function() return env.isfile(path) and env.readfile(path) == png end)
	if not (readSuccess and isCurrent) and not pcall(env.writefile, path, png) then return nil end

	local success, asset = pcall(env.getcustomasset, path)
	if success and type(asset) == "string" then return asset end
	return nil
end

local function indexNames(names: { string }): { [string]: number }
	local index = {}
	for position, name in names do
		index[name] = position - 1
	end
	return index
end

-- Maps every API class to the icon of itself or its nearest superclass that has one
local function buildClassIndex(ownIndex: { [string]: number }, defaultIndex: number, serviceIndex: number?): { [string]: number }
	local index = {}
	for className, apiClass in Context.API.Classes do
		local current, iconIndex = apiClass, nil
		while current and not iconIndex do
			iconIndex = ownIndex[current.Name] or ownIndex[ICON_ALIASES[current.Name]]
			current = current.Superclass
		end

		if iconIndex then
			index[className] = iconIndex
		elseif serviceIndex and apiClass.Tags.Service then
			index[className] = serviceIndex
		else
			index[className] = defaultIndex
		end
	end

	-- Icon names that are not classes, used by context menu items
	for name, position in ownIndex do
		index[name] = index[name] or position
	end
	return index
end

local Icons = {}

-- Must run after ReflectionData.load
function Icons.createClassIconMap()
	local IconMap = Context.Lib.IconMap
	local atlas = IconAtlas.Class
	local asset = loadPng("ClassIcons", atlas.Png)
	local iconMap, ownIndex, defaultIndex, serviceIndex

	if asset then
		iconMap = IconMap.new(asset, atlas.Width, atlas.Height, atlas.Size, atlas.Size)
		ownIndex = indexNames(atlas.Names)
		defaultIndex, serviceIndex = ownIndex.Class, ownIndex.Service
	else
		iconMap = IconMap.newLinear(LEGACY_CLASS_ASSET, 16, 16)
		ownIndex = {}
		for className, rmdClass in Context.RMD.Classes do
			local imageIndex = tonumber(rmdClass.ExplorerImageIndex)
			if imageIndex then ownIndex[className] = imageIndex end
		end
		defaultIndex = 0
	end

	iconMap:SetDict(buildClassIndex(ownIndex, defaultIndex, serviceIndex))
	iconMap.DefaultIndex = defaultIndex
	return iconMap
end

-- 32x32 icons of the main menu tools (Click_Part, Click_Gui, Rejoin), nil without getcustomasset
function Icons.createMenuIconMap()
	local atlas = IconAtlas.Menu
	local asset = loadPng("MenuIcons", atlas.Png)
	if not asset then return nil end

	local iconMap = Context.Lib.IconMap.newLinear(asset, atlas.Size, atlas.Size)
	iconMap:SetDict(indexNames(atlas.Names))
	return iconMap
end

return Icons
